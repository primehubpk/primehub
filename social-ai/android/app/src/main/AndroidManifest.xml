<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Android 11+ scoped visibility: show only launchable installed apps, never QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:label="PrimeHub Social AI"
        android:icon="@drawable/launcher_icon"
        android:roundIcon="@drawable/launcher_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">
        <activity android:name=".InstalledAppsActivity" android:exported="false"/>
        <activity android:name=".DeviceCheckActivity" android:exported="false"/>
        <activity android:name=".PairDeviceActivity" android:exported="false"/>
        <activity android:name=".UpdateActivity" android:exported="false"/>
        <activity android:name=".TikTokAccountActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="primehubsocial" android:host="tiktok-account"/>
            </intent-filter>
        </activity>
        <provider android:name=".VerifiedApkProvider"
            android:authorities="${applicationId}.apkfile"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity android:name=".TaskActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="primehubsocial" android:host="import"/>
            </intent-filter>
        </activity>
        <receiver android:name=".TaskActivity$ReminderReceiver" android:exported="false"/>
        <receiver android:name=".TaskActivity$BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>