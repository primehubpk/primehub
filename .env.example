# Public canonical site URL used by metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://primehubmall.com

# Salaar bot service. If blank, the store loads normally and chat is hidden.
# This is server-read in the root layout; do not put secrets here.
BOT_PUBLIC_URL=

# Meta WhatsApp Embedded Signup / Coexistence.
# Public IDs only. Never place App Secret or access tokens in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Cloudflare R2 — copy to .env.local. Never commit real keys.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=primehub
R2_PUBLIC_BASE_URL=https://images.primehubmall.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Dual backend migration — server only unless NEXT_PUBLIC_* is explicitly required.
# Phase 3 is complete: Supabase is primary for reads and Firebase remains fallback.
# Canonical read switch: PRIMEHUB_DATA_READ_MODE.
# Runtime also accepts the legacy PRIMEHUB_BACKEND_READ_MODE during cutover.
# Keep writes Firebase-primary during the first production stabilization stage;
# successful writes mirror to Supabase and can be cut over separately after smoke/parity checks.
PRIMEHUB_DATA_READ_MODE=supabase-primary
PRIMEHUB_BACKEND_WRITE_MODE=firebase-primary
SUPABASE_URL=
# Public/publishable project key used for RLS-protected public catalog reads.
# This is not the service-role secret, but keep server env naming canonical here.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret used for private reads and Firebase-primary -> Supabase write mirroring.
# Never expose this as NEXT_PUBLIC_* and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 one-time migration runner only. Never commit the real JSON value.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Admin/Auth existing runtime values remain required while Firebase Auth is authoritative.
FIREBASE_ADMIN_UID=

# PrimeHub Admin login — server-only. Required for the signed HttpOnly admin session.
# Never expose the real value as NEXT_PUBLIC_ADMIN_PASSWORD or commit it.
ADMIN_PASSWORD=

# Salaar never-fail tuning. Defaults are already safe; override only if needed.
SALAAR_AI_TIMEOUT_MS=9000
SALAAR_VISION_TIMEOUT_MS=14000
SALAAR_AI_FAILURE_THRESHOLD=2
SALAAR_AI_COOLDOWN_MS=90000
SALAAR_AI_LONG_COOLDOWN_MS=300000
SALAAR_CATALOG_BACKUP_KEY=system/salaar/catalog-last-good-v1.json
SALAAR_CATALOG_BACKUP_MAX_AGE_MS=604800000

# Optional Salaar operations notifications.
RESEND_API_KEY=
SALAAR_OPS_EMAIL=
SALAAR_FROM_EMAIL=
