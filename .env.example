# Public canonical site URL used by metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://primehubmall.com

# Salar Phase 1 AI providers — server only. Never commit real key values.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=

# Meta WhatsApp Embedded Signup / Coexistence.
# Public IDs only. Never place App Secret or access tokens in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Cloudflare R2 — copy to .env.local. Never commit real keys.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=primehub
R2_PUBLIC_BASE_URL=https://images.primehubmall.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Dual backend migration — server only unless NEXT_PUBLIC_* is explicitly required.
# Supabase is primary for reads and Firebase remains fallback.
PRIMEHUB_DATA_READ_MODE=supabase-primary
PRIMEHUB_BACKEND_WRITE_MODE=firebase-primary
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time migration runner only. Never commit the real JSON value.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Admin/Auth existing runtime values remain required while Firebase Auth is authoritative.
FIREBASE_ADMIN_UID=

# PrimeHub Admin login — server-only. Required for the signed HttpOnly admin session.
ADMIN_PASSWORD=
