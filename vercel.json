{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "PRIMEHUB_DATA_READ_MODE": "supabase-primary"
  },
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/notifications/cron?period=morning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/notifications/cron?period=evening",
      "schedule": "0 17 * * *"
    }
  ]
}
