rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminUid() { return "BZfIarsxGkXwZUIEcfFXa9u7Ge02"; }
    function isAdmin() { return signedIn() && request.auth.uid == adminUid(); }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(['customer','items','totalItems','subtotal','total','currency','status','source','createdAt'])
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasAll(['name','phone','email','address','city','notes'])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.email is string
        && request.resource.data.customer.address is string
        && request.resource.data.customer.city is string
        && request.resource.data.customer.notes is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.totalItems is int
        && request.resource.data.totalItems > 0
        && request.resource.data.subtotal is number
        && request.resource.data.total is number
        && request.resource.data.total == request.resource.data.subtotal
        && request.resource.data.currency == 'PKR'
        && request.resource.data.status == 'pending'
        && (request.resource.data.source == 'website' || request.resource.data.source == 'WhatsApp')
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.productId is string
        && request.resource.data.name is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;
      allow update, delete: if isAdmin();
    }
    match /vendor_submissions/{submissionId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }
    match /reward_gifts/{giftId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /reward_redemptions/{redemptionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.giftId is string
        && request.resource.data.pointsCost is int
        && request.resource.data.pointsCost > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /user_rewards/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.points >= 0
        && request.resource.data.points <= 100
        && request.resource.data.keys().hasOnly(['points','streak','lastCheckIn','lastSpin','coupons','updatedAt']);
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.points >= 0
        && request.resource.data.points <= resource.data.points + 100
        && request.resource.data.keys().hasOnly(['points','streak','lastCheckIn','lastSpin','coupons','updatedAt'])
      );
      allow delete: if isAdmin();
    }
    match /media_assets/{assetId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /admin_audit_logs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
