rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminUid() { return "BZfIarsxGkXwZUIEcfFXa9u7Ge02"; }
    function isAdmin() { return signedIn() && request.auth.uid == adminUid(); }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      // Customer orders are created only by the protected server route.
      // This prevents browser/devtools/URL manipulation from writing a fake
      // discounted price directly into Firestore.
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.productId is string
        && request.resource.data.name is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;
      allow update, delete: if isAdmin();
    }
    match /vendor_submissions/{submissionId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }
    match /reward_gifts/{giftId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /reward_redemptions/{redemptionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && (
          (request.resource.data.giftId is string
            && request.resource.data.pointsCost is int
            && request.resource.data.pointsCost > 0)
          ||
          (request.resource.data.wheelWinId is string
            && request.resource.data.pointsCost is int
            && request.resource.data.pointsCost == 0)
        );
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /reward_wins/{winId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.prizeId is string
        && request.resource.data.name is string
        && request.resource.data.type is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'redeemed']
      );
      allow delete: if isAdmin();
    }
    match /user_rewards/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.points >= 0
        && request.resource.data.points <= 100
        && request.resource.data.keys().hasOnly(['points','streak','lastCheckIn','lastSpin','coupons','updatedAt']);
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.points >= 0
        && request.resource.data.points <= resource.data.points + 100
        && request.resource.data.keys().hasOnly(['points','streak','lastCheckIn','lastSpin','coupons','updatedAt'])
      );
      allow delete: if isAdmin();
    }
    match /media_assets/{assetId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /admin_audit_logs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
